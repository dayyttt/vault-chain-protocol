# ============================================================================
# SOURCE CHAIN — Sepolia (11155111). Read-only: origin token lookup + originTokenId.
# ============================================================================
NEXT_PUBLIC_SEPOLIA_UNIVERSAL_FACTORY=
NEXT_PUBLIC_SEPOLIA_ORIGIN_ID_HELPER=
NEXT_PUBLIC_SEPOLIA_TOKEN_REGISTRY=
NEXT_PUBLIC_SEPOLIA_DEX_ROUTER=
# payFee(originTokenId, destinationChainId) = 0.015 ETH. Sepolia-only, not yet wired.
NEXT_PUBLIC_SEPOLIA_LAUNCH_FEE_GATEWAY=
NEXT_PUBLIC_SEPOLIA_DEX_SWAP_URL=
# Example: https://eth-sepolia.g.alchemy.com/v2/<API_KEY>
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# ============================================================================
# DESTINATION CHAIN — Base Sepolia (84532). Deploy/liquidity/LP-timelock.
# Fill these before launch; the frontend refuses to launch if any lacks bytecode.
# ============================================================================
NEXT_PUBLIC_TEST_DESTINATION=baseSepolia
NEXT_PUBLIC_BASE_SEPOLIA_UNIVERSAL_FACTORY=
NEXT_PUBLIC_BASE_SEPOLIA_ORIGIN_ID_HELPER=
NEXT_PUBLIC_BASE_SEPOLIA_TOKEN_REGISTRY=
# Fee gateway on the source network; fixed 0.015 ETH per new wrapper.
NEXT_PUBLIC_BASE_SEPOLIA_LAUNCH_FEE_GATEWAY=
# Must be a Uniswap V2-compatible router (needs addLiquidityETH).
NEXT_PUBLIC_BASE_SEPOLIA_DEX_ROUTER=
NEXT_PUBLIC_BASE_SEPOLIA_DEX_SWAP_URL=
# Example: https://base-sepolia-rpc.publicnode.com
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# Alternative destination: set NEXT_PUBLIC_TEST_DESTINATION=optimismSepolia.
NEXT_PUBLIC_OPTIMISM_SEPOLIA_UNIVERSAL_FACTORY=
NEXT_PUBLIC_OPTIMISM_SEPOLIA_ORIGIN_ID_HELPER=
NEXT_PUBLIC_OPTIMISM_SEPOLIA_TOKEN_REGISTRY=
NEXT_PUBLIC_OPTIMISM_SEPOLIA_LAUNCH_FEE_GATEWAY=
NEXT_PUBLIC_OPTIMISM_SEPOLIA_DEX_ROUTER=
NEXT_PUBLIC_OPTIMISM_SEPOLIA_DEX_SWAP_URL=
NEXT_PUBLIC_OPTIMISM_SEPOLIA_RPC_URL=

# Etherscan API key (server-side only, no NEXT_PUBLIC_ prefix).
ETHERSCAN_API_KEY=
